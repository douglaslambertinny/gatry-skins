<section class="promotion">
  <% data.data.forEach(item => { %>
  <div class="container-card">
    <div class="image-card">
      <img
        src="https://steamcommunity-a.akamaihd.net/economy/image/-9a81dlWLwJ2UUGcVs_nsVtzdOEdtWwKGZZLQHTxDZ7I56KU0Zwwo4NUX4oFJZEHLbXH5ApeO4YmlhxYQknCRvCo04DEVlxkKgpovbSsLQJf3qr3czxb49KzgL-Khsj7OrfUklRc7cF4n-SPo9-n0QSyqUo_ZWuhJtDHIQFtaA7SrwDrxuvthJW8uJuYn3Rlu3Yj7WGdwUL86I2c2w/256fx256f"
        alt="logo"
      />
    </div>
    <div class="content-card">
      <div class="title"><%= item.name %></div>
      <div class="amount-card">
        <div class="title2">
          <%= item.phase %> <%= item.collection %> <%= item.type %> - <%=
          item.rarity %>
        </div>
        <div class="discount-card"><%= item.discount %></div>
        <div class="price-card">R$<%= item.price %></div>
        <div class="exterior-card"><%= item.exterior %></div>
      </div>
      <div class="float"><%= item.float %></div>
      <div class="footer-card">
        <!-- Coment -->
        <button type="button">Comentários</button>
        <button type="submit">Ir Dashskins</button>
      </div>
    </div>
  </div>
  <% }); %>
</section>
