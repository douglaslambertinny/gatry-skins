    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Gatry Test",
            "program": "${workspaceFolder}/app.js",
            "runtimeExecutable": "/opt/homebrew/bin/node"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch with nodemon",
            "runtimeExecutable": "nodemon",
            "program": "${workspaceFolder}/app.js",
            "restart": true,
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            // "env": {
